# SBT build artifacts
target/
project/target/
project/project/

# IDE files
.idea/
.bsp/
*.iml
.metals/
.bloop/
.vscode/

# Booktest runtime files (not committed to Git)
books/.cache/
books/.out/
# booktest's own suite runs in ~3s, so a committed manifest here would be pure
# churn — every commit invalidates it. CONSUMERS commit theirs; that is the
# whole point (see README, "Result stamps").
books/_stamps.manifest

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.swp
*.swo
*~

# Credentials and secrets
*.pem
*.key
.env
.env.local
